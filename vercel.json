{
  "framework": "vite",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/whatsapp/webhook",
      "destination": "/api/whatsapp/webhook"
    },
    {
      "source": "/api/webhook/whatsapp",
      "destination": "/api/whatsapp/webhook"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
