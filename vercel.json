{
  "framework": "vite",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/whatsapp",
      "destination": "/api/whatsapp/index"
    },
    {
      "source": "/api/whatsapp/webhook",
      "destination": "/api/whatsapp/webhook"
    },
    {
      "source": "/api/webhook/whatsapp",
      "destination": "/api/whatsapp/webhook"
    },
    {
      "source": "/api/whatsapp/test",
      "destination": "/api/whatsapp/test"
    },
    {
      "source": "/api/whatsapp/config",
      "destination": "/api/whatsapp/config"
    },
    {
      "source": "/api/whatsapp/send-test",
      "destination": "/api/whatsapp/send-test"
    },
    {
      "source": "/api/whatsapp/disconnect",
      "destination": "/api/whatsapp/disconnect"
    },
    {
      "source": "/api/whatsapp/embedded-signup",
      "destination": "/api/whatsapp/embedded-signup"
    },
    {
      "source": "/api/whatsapp/templates",
      "destination": "/api/whatsapp/templates"
    },
    {
      "source": "/api/whatsapp/templates/(.*)",
      "destination": "/api/whatsapp/templates"
    },
    {
      "source": "/api/whatsapp/data-deletion",
      "destination": "/api/whatsapp/data-deletion"
    },
    {
      "source": "/api/data-deletion",
      "destination": "/api/whatsapp/data-deletion"
    },
    {
      "source": "/api/whatsapp/oauth/start",
      "destination": "/api/whatsapp/oauth/start"
    },
    {
      "source": "/api/whatsapp/oauth/callback",
      "destination": "/api/whatsapp/oauth/callback"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
