# ==========================================
# GEMINI AI AGENT CONFIGURATION
# ==========================================
# Required for WhatsApp AI auto-reply generation via Gemini 3.6 Flash
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ==========================================
# FIREBASE & CLOUD FIRESTORE CREDENTIALS
# ==========================================
# Method A: Individual Firebase Service Account fields
FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@YOUR_PROJECT.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.appspot.com"

# Method B: Entire Service Account JSON (Alternative)
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"..."}'

# ==========================================
# META WHATSAPP CLOUD API CONFIGURATION
# ==========================================
# Webhook verification token configured in Meta Developer Portal
META_DEFAULT_WEBHOOK_VERIFY_TOKEN="fishcatch_verify_token_123"

# ==========================================
# APPLICATION & DEPLOYMENT CONFIGURATION
# ==========================================
# Single-user personal application mode (set to 'true' to bypass login/signup requirement, or 'false' to enforce auth)
PERSONAL_MODE="true"

# Base public URL where app/webhook is deployed
APP_URL="https://whatsapp-api-tool2.vercel.app"

# JWT secret for user authentication tokens
JWT_SECRET="fishcatch_super_secret_jwt_key_2026"
